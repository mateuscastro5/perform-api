            },
            "url": {
              "raw": "http://localhost:3000/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "register"]
            },
            "description": "Registra um novo usuário no sistema"
          },
          "response": []
        },
